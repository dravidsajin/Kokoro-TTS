{
  "name": "vocalis-ai-studio",
  "version": "1.0.0",
  "description": "Production-ready Full Stack Text-to-Speech Application powered by Vocalis AI, Kokoro-82M AI, Next.js, and Node.js TypeScript",
  "scripts": {
    "start": "./start.sh",
    "run": "./start.sh",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start"
  },
  "keywords": [
    "kokoro",
    "tts",
    "ai",
    "nextjs",
    "nodejs",
    "typescript",
    "text-to-speech"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
